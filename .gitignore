# Ignore security certificates and keys
certs/
*.pem
*.key

# Ignore Python cache files
__pycache__/
*.pyc

# Ignore virtual environments
venv/
env/

# Ignore database files (Optional, but recommended so you don't upload test data)
*.db
*.sqlite3

# Ignore environment variables
.env

# Ignore Kilo project-local config and skills
.kilo/

# Ignore local agent rules
AGENTS.md